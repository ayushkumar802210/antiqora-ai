# ANTIQORA AI Configuration
# Safe Example Template — Never commit real secrets to source control

# Application Port & Mode
PORT=3001
NODE_ENV=development

# AI Provider Configuration ('gemini' | 'openai' | 'local')
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-2.5-flash

# Optional OpenAI Provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Web Search Configuration
# Antiqora defaults to live privacy-focused DuckDuckGo web search when no key is provided.
# Optionally supply Tavily or SerpAPI key for specialized research agents.
SEARCH_PROVIDER=duckduckgo
SEARCH_API_KEY=

# Speech & Voice Settings ('browser' | 'system')
TTS_PROVIDER=browser
STT_PROVIDER=browser

# Local Storage / Database Path
STORAGE_PATH=./data/antiqora_store.json

# Safety & Permission Gate
# Default permission policy level required for auto-approval (0: read-only only, 1: safe actions)
AUTO_CONFIRM_LEVEL=0
