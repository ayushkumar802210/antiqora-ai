{
  "name": "antiqora-ai",
  "version": "1.0.0",
  "description": "ANTIQORA AI — Your Intelligent Digital Companion",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"node server/index.cjs\" \"vite\"",
    "dev:ui": "vite",
    "dev:server": "node server/index.cjs",
    "electron": "electron electron/main.cjs",
    "electron:dev": "concurrently \"node server/index.cjs\" \"vite\" \"wait-on tcp:5173 && electron electron/main.cjs\"",
    "build": "tsc && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node server/index.cjs"
  },
  "keywords": ["ai", "assistant", "desktop", "antiqora"],
  "author": "Antiqora Team",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.27.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.52.0",
    "mammoth": "^1.13.0",
    "multer": "^2.4.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "xlsx": "^0.18.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.6.0",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1"
  }
}
